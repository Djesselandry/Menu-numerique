# Configuration Locale - Restaurant Menu Numérique

## 🔧 Configuration du serveur

# Port d'écoute
PORT=5000

# Base de données PostgreSQL (connection locale)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Landry
DB_NAME=restaurant1_db

# Environnement (development ou production)
NODE_ENV=development

# IMPORTANT: Configurer l'IP WiFi/Ethernet réelle (pas VirtualBox!)
# - Décommentez et changez si la auto-détection est mauvaise
# - Exécutez: node detectIP.js   (pour trouver votre vraie IP)
SERVER_IP=127.20.10.3
