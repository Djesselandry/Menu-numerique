# Configuration Environnement - Menu Numérique

# Port d'écoute du serveur
PORT=5000

# Adresse IP du serveur (optionnel)
# Si vous avez plusieurs interfaces réseau et voulez forcer une IP spécifique,
# décommentez et modifiez cette ligne:
# SERVER_IP=192.168.1.5

# Environnement Node
NODE_ENV=development

# Configuration Base de Données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menu_numeric
DB_USER=postgres
DB_PASSWORD=

# Notes:
# 1. Si SERVER_IP n'est pas défini, l'IP est auto-détectée
# 2. Pour utiliser ce fichier:
#    - Renommez-le en ".env" (sans le ".example")
#    - Modifiez les valeurs selon votre configuration
#
# 3. Pour tester avec une IP spécifique en ligne de commande:
#    Windows (PowerShell): $env:SERVER_IP="192.168.x.x"; npm start
#    Windows (CMD): SET SERVER_IP=192.168.x.x && npm start
#    Linux/Mac: SERVER_IP=192.168.x.x npm start
